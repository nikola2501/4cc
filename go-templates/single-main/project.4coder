version(2);
project_name = "go-template: single-main (standardized)";

// Formatting preferences (optional)
indent_with_tabs = false;
indent_width = 4;
default_tab_width = 4;
indent_clear_blank_lines = false;

// Files included in the project index
patterns = {
  "*.go",
  "go.mod",
  "go.sum",

  "*.md",
  "*.txt",

  "Makefile",
  "*.sh",
  "*.bash",
  "*.zsh",
  "*.bat",

  "*.json",
  "*.yaml",
  "*.yml",
  "*.toml",

  ".env",
  "README*",
  "LICENSE*",
};

// Keep the index clean/fast
blacklist_patterns = {
  ".*",
  ".git/*",

  // Exclude deps by default
  "vendor/*",

  // Common output dirs
  "bin/*",
  "build/*",
  "dist/*",
  "out/*",
  "tmp/*",
};

load_paths = {
  .win = {
    { .path = ".", .recursive = true, .relative = true, },
  },
  .linux = {
    { .path = ".", .recursive = true, .relative = true, },
  },
  .mac = {
    { .path = ".", .recursive = true, .relative = true, },
  },
};

commands = {
  // ----------------------------
  // Go workflow (single main at repo root)
  // ----------------------------

  .build = {
    .win   = "echo build & if not exist bin mkdir bin & go build -o bin\\app.exe .",
    .linux = "echo build && mkdir -p bin && go build -o bin/app .",
    .mac   = "echo build && mkdir -p bin && go build -o bin/app .",
    .out = "*compilation*",
    .footer_panel = true,
    .save_dirty_files = true,
    .cursor_at_end = false,
  },

  .run = {
    .win   = "echo run & go run .",
    .linux = "echo run && go run .",
    .mac   = "echo run && go run .",
    .out = "*run*",
    .footer_panel = false,
    .save_dirty_files = true,
    .cursor_at_end = true,
  },

  .test = {
    .win   = "echo test & go test ./...",
    .linux = "echo test && go test ./...",
    .mac   = "echo test && go test ./...",
    .out = "*compilation*",
    .footer_panel = true,
    .save_dirty_files = true,
    .cursor_at_end = false,
  },

  .fmt = {
    .win   = "echo fmt & gofmt -w .",
    .linux = "echo fmt && gofmt -w .",
    .mac   = "echo fmt && gofmt -w .",
    .out = "*compilation*",
    .footer_panel = true,
    .save_dirty_files = true,
    .cursor_at_end = false,
  },

  // Lint (optional): requires golangci-lint in PATH.
  .lint = {
    .win   = "echo lint & golangci-lint run",
    .linux = "echo lint && golangci-lint run",
    .mac   = "echo lint && golangci-lint run",
    .out = "*compilation*",
    .footer_panel = true,
    .save_dirty_files = true,
    .cursor_at_end = false,
  },

  .vet = {
    .win   = "echo vet & go vet ./...",
    .linux = "echo vet && go vet ./...",
    .mac   = "echo vet && go vet ./...",
    .out = "*compilation*",
    .footer_panel = true,
    .save_dirty_files = true,
    .cursor_at_end = false,
  },

  // ----------------------------
  // Search helpers (ripgrep)
  //
  // NOTE: project commands are static strings, so they can't prompt you for a query.
  // For interactive searches, use 4coder's `execute_any_cli` command and type:
  //   rg -n --hidden --glob '!**/.git/*' '<pattern>' .
  //
  // These entries are still useful as:
  // - reminders of the exact flags you like
  // - editable templates (you can quickly change PATTERN)
  // ----------------------------

  .rg_repo = {
    .win   = "echo rg_repo & rg -n --hidden --glob \"!**/.git/*\" PATTERN .",
    .linux = "echo rg_repo && rg -n --hidden --glob '!**/.git/*' PATTERN .",
    .mac   = "echo rg_repo && rg -n --hidden --glob '!**/.git/*' PATTERN .",
    .out = "*compilation*",
    .footer_panel = true,
    .save_dirty_files = false,
    .cursor_at_end = false,
  },

  .rg_repo_no_vendor = {
    .win   = "echo rg_repo_no_vendor & rg -n --hidden --glob \"!**/.git/*\" --glob \"!vendor/**\" PATTERN .",
    .linux = "echo rg_repo_no_vendor && rg -n --hidden --glob '!**/.git/*' --glob '!vendor/**' PATTERN .",
    .mac   = "echo rg_repo_no_vendor && rg -n --hidden --glob '!**/.git/*' --glob '!vendor/**' PATTERN .",
    .out = "*compilation*",
    .footer_panel = true,
    .save_dirty_files = false,
    .cursor_at_end = false,
  },

  .rg_vendor = {
    .win   = "echo rg_vendor & rg -n PATTERN vendor",
    .linux = "echo rg_vendor && rg -n PATTERN vendor",
    .mac   = "echo rg_vendor && rg -n PATTERN vendor",
    .out = "*compilation*",
    .footer_panel = true,
    .save_dirty_files = false,
    .cursor_at_end = false,
  },

  // ----------------------------
  // Git helpers
  // ----------------------------

  .git_status = {
    .win   = "echo git_status & git status -sb",
    .linux = "echo git_status && git status -sb",
    .mac   = "echo git_status && git status -sb",
    .out = "*git*",
    .footer_panel = true,
    .save_dirty_files = false,
    .cursor_at_end = true,
  },

  // Git blame needs a path (and often a line range). Use 4coder's interactive CLI command
  // to run blame on the current file/line range. This entry is a reminder/template.
  //
  // Examples you can paste into an interactive CLI prompt:
  //   git blame -n -- path/to/file.go
  //   git blame -L 120,180 path/to/file.go
  .git_blame = {
    .win   = "echo git_blame & echo Use interactive CLI: git blame -n -- path/to/file.go",
    .linux = "echo git_blame && echo \"Use interactive CLI: git blame -n -- path/to/file.go\"",
    .mac   = "echo git_blame && echo \"Use interactive CLI: git blame -n -- path/to/file.go\"",
    .out = "*git*",
    .footer_panel = true,
    .save_dirty_files = false,
    .cursor_at_end = true,
  },

  // Diff your current branch against main.
  // If you prefer origin/main change `main...HEAD` -> `origin/main...HEAD`.
  .git_diff_main = {
    .win   = "echo git_diff_main & git fetch --all --prune & git --no-pager diff --stat main...HEAD & git --no-pager diff main...HEAD",
    .linux = "echo git_diff_main && git fetch --all --prune && git --no-pager diff --stat main...HEAD && git --no-pager diff main...HEAD",
    .mac   = "echo git_diff_main && git fetch --all --prune && git --no-pager diff --stat main...HEAD && git --no-pager diff main...HEAD",
    .out = "*git-diff*",
    .footer_panel = true,
    .save_dirty_files = false,
    .cursor_at_end = true,
  },
};

fkey_command = {
  .F1  = "build",
  .F2  = "test",
  .F4  = "run",
  .F5  = "fmt",
  .F6  = "lint",
  .F7  = "vet",

  .F8  = "rg_repo_no_vendor",
  .F9  = "git_status",
  .F10 = "git_diff_main",
};
